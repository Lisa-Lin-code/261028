rules_version = '2';

// 이 파일이 "누가 무엇을 할 수 있는가"의 최종 근거입니다.
// 화면(React)에서 버튼을 숨기는 것은 편의일 뿐, 보안은 아래 규칙이 담당합니다.
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 = admins 컬렉션에 "이메일을 문서 ID로" 등록된 사용자
    // (구글 계정의 이메일 인증이 된 경우에만 인정)
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // 연구 글: 누구나 읽기, 관리자만 쓰기
    match /research/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 수업 자료: 누구나 읽기, 관리자만 쓰기
    match /courses/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 댓글: 읽기는 누구나, 생성은 로그인 + 본인 uid, 삭제는 본인 또는 관리자, 수정 불가
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000;
      allow update: if false;
      allow delete: if isSignedIn()
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // 관리자 명단: 읽기는 "내 이메일 문서"만 (화면에서 관리자 여부 확인용), 쓰기는 클라이언트에서 금지.
    // 명단 변경은 Firebase 콘솔에서만 합니다.
    match /admins/{email} {
      allow read: if isSignedIn() && request.auth.token.email == email;
      allow write: if false;
    }
  }
}
